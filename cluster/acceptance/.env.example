# Required: private Nagios XI image in GHCR (run docker login ghcr.io first)
NAGIOS_XI_IMAGE=ghcr.io/dunkin0486/terraform-provider-nagios-test-nagiosxi:latest

# Optional: if empty, run.sh will derive/enable the nagiosadmin API token from
# inside the running nagiosxi container (same approach used by terraform-provider-nagios).
NAGIOS_API_TOKEN=

# Optional: base URL used in ProviderConfig credentials
NAGIOS_URL=http://nagiosxi/nagiosxi

# Optional: timeout used by kubectl wait
ACCEPTANCE_WAIT_TIMEOUT=900s

# Optional: keep compose volumes on teardown for faster repeated runs.
# Set to true for local development loops.
ACCEPTANCE_KEEP_VOLUMES=false

# Optional: preserve the entire compose stack after tests.
# This is the fastest local mode because Nagios XI stays installed/running.
ACCEPTANCE_PRESERVE_STACK=false
